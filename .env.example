# =====================================================================
# PayPal Agent Shield — Environment Variables Configuration Template
# =====================================================================
# Copy this file to `.env` and configure your credentials:
#   cp .env.example .env
#
# Note: You can also configure or hot-swap all of these keys at runtime
# directly from the web UI using the "⚙️ API Keys (BYOK)" button.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Google Gemini API Key & Model (Required for Google ADK Agent)
# Get your key at: https://aistudio.google.com/app/apikey
# See all available models at: https://aistudio.google.com/docs/models
# ---------------------------------------------------------------------
GOOGLE_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------
# 2. PayPal Sandbox Developer Credentials (Optional - Live vs Simulated Mode)
# Get your Client ID & Secret at: https://developer.paypal.com/dashboard/applications/sandbox
# Monitor your live API calls at: https://developer.paypal.com/dashboard/api-calls/sandbox
# If omitted, the system operates in "SIMULATED" mode for zero-friction testing.
# ---------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------------------------------------------------------------
# 3. Channel3 API Key (Optional - Live Catalog vs Local Fallback)
# Get your key at: https://trychannel3.com/dashboard/api
# If omitted, the agent uses the deterministic local catalog (TRUSTED_CATALOG).
# ---------------------------------------------------------------------
CHANNEL3_API_KEY=

# ---------------------------------------------------------------------
# 4. Render Workflows Configuration (Optional - Distributed Orchestration)
# Get your key at: https://dashboard.render.com/u/settings#api-keys
# When deployed via `render.yaml`, activates the `paypal-shield-workflow` service.
# ---------------------------------------------------------------------
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=paypal-shield-workflow
