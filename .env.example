# =====================================================================
# PayPal Agent Shield — Environment Variables Configuration Template
# =====================================================================
# Copia este archivo como `.env` y configura tus credenciales:
#   cp .env.example .env
#
# Nota: También puedes configurar o actualizar estas llaves en caliente 
# desde la interfaz web usando el botón "⚙️ API Keys (BYOK)".
# =====================================================================

# ---------------------------------------------------------------------
# 1. Google Gemini API Key y Modelo (Requerido para el Agente Google ADK)
# Obtén tu llave en: https://aistudio.google.com/app/apikey
# Ver todos los modelos disponibles en: https://aistudio.google.com/docs/models
# ---------------------------------------------------------------------
GOOGLE_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------
# 2. PayPal Sandbox Developer Credentials (Opcional - Modo Real vs Simulado)
# Obtén tu Client ID y Secret en: https://developer.paypal.com/dashboard/applications/sandbox
# Monitorea tus llamadas API en vivo en: https://developer.paypal.com/dashboard/api-calls/sandbox
# Si no se configuran, el sistema funcionará en modo "SIMULATED" para pruebas locales.
# ---------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------------------------------------------------------------
# 3. Channel3 API Key (Opcional - Catálogo en Vivo vs Fallback Local)
# Obtén tu llave en: https://trychannel3.com/dashboard/api
# Si no se configura, el agente usará el catálogo semilla local (TRUSTED_CATALOG).
# ---------------------------------------------------------------------
CHANNEL3_API_KEY=

# ---------------------------------------------------------------------
# 4. Render Workflows Configuration (Opcional - Orquestación Distribuida)
# Obtén tu llave en: https://dashboard.render.com/u/settings#api-keys
# Cuando se despliega con `render.yaml`, activa el servicio `paypal-shield-workflow`.
# ---------------------------------------------------------------------
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=paypal-shield-workflow
